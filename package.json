{
  "name": "@cbgpu-engineering/agent",
  "version": "0.2.1",
  "description": "CBGPU coding agent powered by the MIT-licensed OpenCode engine",
  "type": "module",
  "bin": {
    "cbgpu": "dist/bin/cbgpu.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.ts",
    "check": "tsc --noEmit && node scripts/check-source-languages.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test:compiled": "node --test test/compiled.test.ts",
    "build:native": "npm run build && node scripts/build-native.ts",
    "package:native": "node scripts/package-native-candidate.ts && node scripts/verify-native-candidate.ts"
  },
  "dependencies": {
    "opencode-ai": "1.19.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CBGPU-Engineering/CBGPU-agent.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/bin",
    "dist/lib",
    "assets/setup",
    "LICENSE",
    "OPENCODE-LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
